  background-color: #888;
  padding: 10px;
  text-align: center;
  color: white;
}

/* Responsive layout - makes the menu and the content sit on top of each other instead of next to each other */
@media (max-width: 600px) {
  .container {
  grid-template-areas:
    "header header header"
    "menu menu menu"
    "content content content"    
    "footer footer footer";
    }
}
